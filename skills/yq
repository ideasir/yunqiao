#!/bin/bash
# yq - 云桥快捷命令
# 用法: yq <配对码> <工具> [参数...]
# 示例: yq 123456 exec dir
#       yq 123456 read test.txt
#       yq 123456 write test.txt "hello"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLIENT="$SCRIPT_DIR/yunqiao-client.mjs"
URL="${YUNQIAO_URL:-https://yunqiao.very.im/mcp}"

# 把参数安全转义为 JSON 字符串（避免引号/反斜杠破坏 JSON，Windows 路径必需）
json_str() {
  node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' "$1"
}

if [ $# -lt 2 ]; then
  echo "用法: yq <配对码> <工具> [参数...]"
  echo ""
  echo "工具:"
  echo "  ls              - 列出设备"
  echo "  exec <cmd>      - 执行命令"
  echo "  read <path>     - 读取文件"
  echo "  write <path> <content> - 写入文件"
  echo "  info            - 设备信息"
  echo "  sessions        - 列出会话"
  echo "  notify <text>   - 发通知到客户端"
  echo "  msg             - 读取客户端发来的消息"
  echo "  download <path> - 下载文件"
  exit 1
fi

CODE="$1"
TOOL="$2"
shift 2

case "$TOOL" in
  ls)
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call list_devices '{}'
    ;;
  exec)
    CMD_JSON=$(json_str "$*")
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call exec "{\"command\":$CMD_JSON}"
    ;;
  read)
    P_JSON=$(json_str "$1")
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call read_file "{\"path\":$P_JSON}"
    ;;
  write)
    P_JSON=$(json_str "$1")
    C_JSON=$(json_str "$2")
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call write_file "{\"path\":$P_JSON,\"content\":$C_JSON}"
    ;;
  info)
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call get_device_info '{}'
    ;;
  sessions)
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call list_sessions '{}'
    ;;
  notify)
    T_JSON=$(json_str "$*")
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call notify "{\"text\":$T_JSON}"
    ;;
  msg)
    # 读取客户端发来的消息
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call get_client_messages '{}'
    ;;
  call)
    # 透传任意工具：yq <配对码> call <工具名> '<json参数>'
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call "$1" "$2"
    ;;
  download)
    P_JSON=$(json_str "$1")
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call download "{\"path\":$P_JSON}"
    ;;
  screenshot)
    PS_CMD='powershell -Command Add-Type -AssemblyName System.Windows.Forms; Add-Type -AssemblyName System.Drawing; $v = [System.Windows.Forms.Screen]::AllScreens; $w=0; $h=0; foreach($s in $v){if($s.Bounds.Right -gt $w){$w=$s.Bounds.Right}; if($s.Bounds.Bottom -gt $h){$h=$s.Bounds.Bottom}}; $b=New-Object System.Drawing.Bitmap($w,$h); $g=[System.Drawing.Graphics]::FromImage($b); $g.CopyFromScreen(0,0,0,0,$b.Size); $b.Save("screenshot.png"); echo screenshot.png'
    CMD_JSON=$(json_str "$PS_CMD")
    YUNQIAO_URL="$URL" node "$CLIENT" "$CODE" call exec "{\"command\":$CMD_JSON}"
    ;;
  *)
    echo "未知工具: $TOOL"
    exit 1
    ;;
esac
