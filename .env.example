# 预共享密钥，服务端和客户端必须一致
RELAY_PSK=change-me-to-a-secure-random-string

# 公网服务器监听端口
PORT=9876

# 公网服务器地址（agent 端配置）
RELAY_URL=ws://your-server.com:9876/device

# 私人电脑名称
DEVICE_NAME=my-computer

# 断线重连间隔（毫秒）
RECONNECT_DELAY=5000

# 命令执行超时（毫秒）
COMMAND_TIMEOUT=60000

# --- 安全边界（可选，默认不限制） ---

# 允许执行的命令前缀（逗号分隔），留空=不限制
# 例: ALLOWED_COMMANDS=node,python,git,powershell
ALLOWED_COMMANDS=

# 允许读写的文件路径前缀，留空=不限制
# 例: ALLOWED_FILE_PREFIX=D:\aicodework\github
ALLOWED_FILE_PREFIX=